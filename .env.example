# Configuração local para `docker compose up --build`.
# Estes valores são apenas para desenvolvimento local; não use em produção.
PORT=3000
WS_PORT=3300
POSTGRES_PORT=5432
POSTGRES_USER=lavi
POSTGRES_PASSWORD=lavi_dev_only
POSTGRES_DB=lavi
REDIS_HOST_PORT=6379

# Credenciais de placeholder bastam para iniciar os serviços.
# Recursos de upload para S3 exigem credenciais AWS reais e um bucket existente.
ENCRYPT_CORE_KEY=local-development-encryption-key
BLIND_KEY=local-development-blind-key
JWT_KEY=local-development-jwt-key
BUCKET_NAME=lavi-local
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder
AWS_REGION=us-east-1
